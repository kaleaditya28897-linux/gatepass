# GatePass web tier: serves the built React app, terminates TLS and proxies the API.
#
# SITE_ADDRESS   what browsers type, e.g. gatepass.example.com, 192.168.1.50 or localhost.
#                Use ":80" (or http://host) for plain HTTP behind another TLS proxy.
# TLS_DIRECTIVE  empty  -> automatic public certificate (needs a real domain + ports 80/443 reachable)
#                "tls internal" -> certificate from Caddy's own local CA (LAN / IP address installs)
{
	admin off
	{$CADDY_GLOBAL_OPTIONS}
}

# Internal health endpoint for the container healthcheck (never published).
:8080 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS:localhost} {
	{$TLS_DIRECTIVE}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 10MB
	}

	# Django: REST API and the Django admin site.
	@backend path /api/* /django-admin/*
	handle @backend {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Files collected from Django (admin CSS/JS).
	handle_path /static/* {
		root * /var/www/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Uploaded/generated media (pass QR codes, photos).
	handle_path /media/* {
		root * /var/www/media
		header Cache-Control "private, max-age=3600"
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'"
		file_server
	}

	# The React single-page app.
	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
