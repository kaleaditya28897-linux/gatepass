# Copy this file to .env.production before starting the production stack,
# or run ./deploy.sh which fills it in for you.

# --- Where the building reaches GatePass ------------------------------------
# The host name or IP address people type into the browser (no https://).
SITE_ADDRESS=gatepass.example.com
# Leave empty for an automatic public HTTPS certificate (needs a real domain that
# points at this server, with ports 80 and 443 reachable from the internet).
# Use "tls internal" for an office-network / IP-address install: Caddy then issues
# a certificate from its own local CA (browsers warn until that CA is trusted).
TLS_DIRECTIVE=
HTTP_PORT=80
HTTPS_PORT=443

# Full public URL; used in QR codes and the pass links sent to visitors.
FRONTEND_URL=https://gatepass.example.com
ALLOWED_HOSTS=gatepass.example.com
CORS_ALLOWED_ORIGINS=https://gatepass.example.com
CSRF_TRUSTED_ORIGINS=https://gatepass.example.com
VITE_API_URL=/api/v1

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=gatepass.settings.production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
TIME_ZONE=Asia/Kolkata
# Set to False only if GatePass is served over plain HTTP (not recommended:
# guards' phones need HTTPS to use the camera for QR scanning).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Database ----------------------------------------------------------------
DB_NAME=gatepass
DB_USER=gatepass
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# --- Redis / Celery / cache --------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Email (pass links to visitors) -------------------------------------------
# Leave EMAIL_HOST_USER empty to disable real email (messages go to the celery log).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gatepass.example.com

# --- SMS (pass links, visitor-arrived alerts, delivery OTPs) -------------------
# "console" only writes messages to the celery log. Set to "twilio" and fill in
# the three values below to send real SMS.
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Gate rules ----------------------------------------------------------------
# Minutes before the pass start time that a visitor may already be checked in.
PASS_EARLY_CHECKIN_MINUTES=30
# How long a walk-in pass created at the gate stays valid.
WALK_IN_VALIDITY_HOURS=8
# Wrong OTP attempts before a delivery is locked.
DELIVERY_OTP_MAX_ATTEMPTS=5
